# Salin ke .env dan isi. File .env tidak di-commit.

# apps/api
HOST=127.0.0.1
PORT=3000

# Supabase: dipakai hanya oleh apps/api. Service role key tidak boleh masuk bundle klien.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=contents

# Koneksi Postgres langsung (untuk script migrasi). Jangan pakai di bundle klien.
DATABASE_URL=

# Auth Admin (tahap 4)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
