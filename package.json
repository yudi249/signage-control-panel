{
  "name": "signage-control-panel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev:api": "pnpm --filter @signage/api dev",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/db-migrate.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint:boundaries"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "^16.8.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.0"
  }
}
